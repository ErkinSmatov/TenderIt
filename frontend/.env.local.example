# Next.js environment variables — copy to .env.local and fill in values

# Backend API base URL (used by api.ts for client-side fetch)
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT secret — must match backend JWT_SECRET env var
# Used by middleware.ts (server-side Edge) to verify access_token cookie signatures
# NOT prefixed with NEXT_PUBLIC because middleware runs server-side only
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-must-match-backend-jwt-secret
