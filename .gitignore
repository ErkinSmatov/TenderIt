# !.vscode/settings.json

# HAR captures and spike raw captures — may contain session tokens, cookies, PII; never commit
*.har
backend/spikes/findings/raw-captures/
backend/spikes/findings/*.har

# Alembic migrations are version controlled — do NOT gitignore versions/
